# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/clinic_management

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Email (V1 uses this only for booking-confirmation emails; safe to leave blank in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@clinicapp.com

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# --- V2 additions ---

# Payment: "mock" works out of the box for local dev/demo (instantly succeeds).
# Swap to "bkash" / "sslcommerz" once you have real merchant credentials —
# see src/services/paymentService.js for the adapter pattern.
PAYMENT_PROVIDER=mock
BKASH_APP_KEY=
BKASH_APP_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASS=

# File uploads (document vault)
MAX_UPLOAD_MB=10

# --- V3 additions ---

# AI: "mock" works out of the box (canned, clearly-labeled responses) —
# good for demoing the flow without an API key. Set to "anthropic" and add
# your key to unlock real symptom-checking / chatbot answers.
# Get a key at https://console.anthropic.com
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
